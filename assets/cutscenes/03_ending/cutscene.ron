// HALLWAYS cutscene: the ending (plays when the final door opens).
// Anchor positions are relative to the far side of the final door: x across,
// y up, z negative = deeper. The exit lift car is centred at (0, 0, -4.4).
// Built-in music: rising dread to 15.4 s, silence after the crash at 16.3 s.
// Your own music: assets/music/cutscene_ending/ (any one audio file, 17-60 s).
(
    title: "The Way Out",
    duration: 22.0,
    letterbox: true,
    skippable: true,
    shots: [
        // Behind you in the final hall as you walk through the door.
        (start: 0.0, end: 3.2, fov: 60.0, ease: Linear,
            from: Anchor(pos: (1.1, 1.8, 4.8), look: (0.0, 1.3, -2.0)),
            to:   Anchor(pos: (0.7, 1.7, 3.6), look: (0.0, 1.3, -3.0))),
        // Inside the lift, looking out as everyone steps in.
        (start: 3.2, end: 6.4, fov: 64.0, ease: InOut,
            from: Anchor(pos: (0.9, 2.2, -5.6), look: (0.0, 1.2, -0.5)),
            to:   Anchor(pos: (0.7, 2.1, -5.4), look: (0.0, 1.3, -1.5))),
        // From the landing as the gate rattles down.
        (start: 6.4, end: 9.0, fov: 55.0, ease: InOut,
            from: Anchor(pos: (0.9, 1.7, -0.6), look: (0.0, 1.4, -4.4)),
            to:   Anchor(pos: (0.4, 1.6, -1.4), look: (0.0, 1.4, -4.4))),
        // Low in the shaft, watching the car climb.
        (start: 9.0, end: 12.4, fov: 62.0, ease: InOut,
            from: Anchor(pos: (0.6, 0.8, -1.9), look: (0.0, 2.0, -4.4)),
            to:   Anchor(pos: (0.5, 1.0, -1.9), look: (0.0, 4.5, -4.4))),
        // Inside the car, looking up as the claws come through the roof.
        (start: 12.4, end: 15.2, fov: 70.0, ease: InOut,
            from: Anchor(pos: (0.8, 5.9, -3.3), look: (0.0, 5.6, -4.8)),
            to:   Anchor(pos: (0.6, 5.7, -3.2), look: (0.0, 6.6, -4.5))),
        // Above the car in the shaft: the cable snaps and it drops away.
        (start: 15.2, end: 22.0, fov: 66.0, ease: Out,
            from: Anchor(pos: (0.6, 9.4, -3.1), look: (0.0, 5.5, -4.4)),
            to:   Anchor(pos: (0.5, 9.6, -3.2), look: (0.0, 1.0, -4.5))),
    ],
    events: [
        (at: 0.0, do: Ending(Build)),
        (at: 0.2, do: Ending(Walk(seconds: 5.6))),
        (at: 0.4, do: Subtitle(text: "[The last door groans open onto a waiting lift]", seconds: 2.8)),
        (at: 6.6, do: Ending(CloseGate(seconds: 1.2))),
        (at: 6.7, do: Sfx(GateRattle)),
        (at: 8.4, do: Sfx(Ding)),
        (at: 9.0, do: Ending(Rise(meters: 4.0, seconds: 3.4))),
        (at: 9.0, do: Sfx(Rumble)),
        (at: 9.4, do: Subtitle(text: "[Going up]", seconds: 2.0)),
        (at: 11.6, do: Lights(color: (1.0, 0.4, 0.3), amount: 0.4, scale: 0.8, flicker: 0.7)),
        (at: 12.0, do: Shake(0.4)),
        (at: 12.6, do: Sfx(Stinger)),
        (at: 12.6, do: Ending(Attack)),
        (at: 12.7, do: Shake(0.9)),
        (at: 12.8, do: Ending(Panic)),
        (at: 12.9, do: Subtitle(text: "[Something tears through the roof]", seconds: 2.2, danger: true)),
        (at: 14.4, do: Sfx(SurgeRoar)),
        (at: 15.3, do: Sfx(GateRattle)),
        (at: 15.4, do: Ending(Snap)),
        (at: 15.4, do: Subtitle(text: "[The cable snaps]", seconds: 1.2, danger: true)),
        (at: 15.5, do: Shake(1.0)),
        (at: 16.3, do: Fade(alpha: 1.0, seconds: 0.0)),
        (at: 16.3, do: Sfx(Rumble)),
        (at: 16.35, do: Sfx(Stinger)),
        (at: 16.3, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.0)),
        (at: 18.0, do: Title(text: "YOU ESCAPED", sub: "...didn't you?", seconds: 3.6)),
    ],
    end: Victory,
)
