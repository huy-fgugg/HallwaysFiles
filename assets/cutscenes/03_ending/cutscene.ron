// HALLWAYS cutscene: the ending (plays when the final door opens).
// Anchor positions are relative to the far side of the final door: x across,
// y up, z negative = deeper. The exit lift car is centred at (0, 0, -4.4).
// Built-in music: a long climb from 9 s, rising dread to 20.4 s, the crash (cut to black) at 21.8 s.
// Your own music: assets/music/cutscene_ending/ (any one audio file, 17-60 s).
(
    title: "The Way Out",
    duration: 27.0,
    letterbox: true,
    skippable: true,
    shots: [
        // Behind you in the final hall as you walk through the door.
        (start: 0.0, end: 3.2, fov: 60.0, ease: Linear,
            from: Anchor(pos: (1.1, 1.8, 4.8), look: (0.0, 1.3, -2.0)),
            to:   Anchor(pos: (0.7, 1.7, 3.6), look: (0.0, 1.3, -3.0))),
        // Inside the lift, looking out as everyone steps in.
        (start: 3.2, end: 6.4, fov: 64.0, ease: InOut,
            from: Anchor(pos: (0.9, 2.2, -5.6), look: (0.0, 1.2, -0.5)),
            to:   Anchor(pos: (0.7, 2.1, -5.4), look: (0.0, 1.3, -1.5))),
        // From the landing as the gate rattles down.
        (start: 6.4, end: 9.0, fov: 55.0, ease: InOut,
            from: Anchor(pos: (0.9, 1.7, -0.6), look: (0.0, 1.4, -4.4)),
            to:   Anchor(pos: (0.4, 1.6, -1.4), look: (0.0, 1.4, -4.4))),
        // Low in the shaft, watching the car begin its long climb.
        (start: 9.0, end: 13.4, fov: 62.0, ease: InOut,
            from: Anchor(pos: (0.6, 0.8, -1.9), look: (0.0, 2.0, -4.4)),
            to:   Anchor(pos: (0.5, 1.0, -1.9), look: (0.0, 6.0, -4.4))),
        // High in the shaft, looking down as the car climbs toward the light.
        (start: 13.4, end: 17.4, fov: 58.0, ease: InOut,
            from: Anchor(pos: (0.9, 15.5, -2.6), look: (0.0, 6.0, -4.4)),
            to:   Anchor(pos: (0.8, 15.2, -2.7), look: (0.0, 9.5, -4.4))),
        // Inside the car, looking up as the claws come through the roof.
        (start: 17.4, end: 19.6, fov: 70.0, ease: InOut,
            from: Anchor(pos: (0.8, 10.9, -3.3), look: (0.0, 10.6, -4.8)),
            to:   Anchor(pos: (0.6, 10.7, -3.2), look: (0.0, 11.6, -4.5))),
        // On the roof beside the cable: a clawed arm lunges out of the dark
        // and slashes it.
        (start: 19.6, end: 20.9, fov: 62.0, ease: Linear,
            from: Anchor(pos: (1.3, 13.0, -2.9), look: (-0.4, 12.7, -4.4)),
            to:   Anchor(pos: (1.2, 12.9, -3.0), look: (-0.2, 12.8, -4.4))),
        // Above the car in the shaft: it drops away.
        (start: 20.9, end: 27.0, fov: 66.0, ease: Out,
            from: Anchor(pos: (0.6, 14.4, -3.1), look: (0.0, 10.5, -4.4)),
            to:   Anchor(pos: (0.5, 14.6, -3.2), look: (0.0, 1.0, -4.5))),
    ],
    events: [
        (at: 0.0, do: Ending(Build)),
        (at: 0.2, do: Ending(Walk(seconds: 5.6))),
        (at: 0.4, do: Subtitle(text: "[The last door groans open onto a waiting lift]", seconds: 2.8), players: Some((1, 1))),
        (at: 0.4, do: Subtitle(text: "[The last door groans open. A lift is waiting for {party}]", seconds: 2.8), players: Some((2, 5))),
        (at: 6.6, do: Ending(CloseGate(seconds: 1.2))),
        (at: 6.7, do: Sfx(GateRattle)),
        (at: 8.4, do: Sfx(Ding)),
        (at: 9.0, do: Ending(Rise(meters: 9.0, seconds: 8.4))),
        (at: 9.0, do: Sfx(Rumble)),
        (at: 9.4, do: Subtitle(text: "[Going up]", seconds: 2.0), players: Some((1, 1))),
        (at: 9.4, do: Subtitle(text: "[Going up, all {n} of you]", seconds: 2.0), players: Some((2, 5))),
        (at: 12.0, do: Sfx(Ding)),
        (at: 12.3, do: Subtitle(text: "[Floor after floor slides by. The light above grows brighter.]", seconds: 2.8)),
        (at: 14.4, do: Subtitle(text: "[Almost out]", seconds: 1.8), players: Some((1, 1))),
        (at: 14.4, do: Subtitle(text: "[Almost out. All {n} of you.]", seconds: 1.8), players: Some((2, 5))),
        (at: 15.2, do: Sfx(Ding)),
        (at: 16.6, do: Lights(color: (1.0, 0.4, 0.3), amount: 0.4, scale: 0.8, flicker: 0.7)),
        (at: 17.0, do: Shake(0.4)),
        (at: 17.6, do: Sfx(Stinger)),
        (at: 17.6, do: Ending(Attack)),
        (at: 17.7, do: Shake(0.9)),
        (at: 17.8, do: Ending(Panic)),
        (at: 17.9, do: Subtitle(text: "[Something tears through the roof]", seconds: 2.2, danger: true)),
        (at: 19.4, do: Sfx(SurgeRoar)),
        (at: 19.7, do: Ending(Swipe)),
        (at: 19.8, do: Sfx(Whoosh)),
        (at: 20.0, do: Subtitle(text: "[A claw lashes out of the dark at the cable]", seconds: 1.4, danger: true)),
        (at: 20.15, do: Ending(Cut)),
        (at: 20.15, do: Sfx(GateRattle)),
        (at: 20.2, do: Shake(0.8)),
        (at: 20.9, do: Ending(Snap)),
        (at: 20.9, do: Subtitle(text: "[The cable parts. The lift drops.]", seconds: 1.2, danger: true)),
        (at: 21.0, do: Shake(1.0)),
        (at: 21.8, do: Fade(alpha: 1.0, seconds: 0.0)),
        (at: 21.8, do: Sfx(Rumble)),
        (at: 21.85, do: Sfx(Stinger)),
        (at: 21.8, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.0)),
        (at: 23.0, do: Title(text: "YOU ESCAPED", sub: "...didn't you?", seconds: 3.6), players: Some((1, 1))),
        (at: 23.0, do: Title(text: "{N} OF YOU ESCAPED", sub: "...didn't you?", seconds: 3.6), players: Some((2, 5))),
    ],
    end: Victory,
)
