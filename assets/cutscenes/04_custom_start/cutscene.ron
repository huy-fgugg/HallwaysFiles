// HALLWAYS cutscene: the opening of a custom floor (or a map from the map builder).
// Anchor positions are relative to the entry door of the floor's first room:
// x across, y up, z negative = into the room.
// In captions {floor} is the floor's name, {area} its first area, {doors} its last door.
(
    title: "Custom Floor",
    duration: 8.0,
    letterbox: true,
    skippable: true,
    shots: [
        // High in the corner by the door, looking down the first room.
        (start: 0.0, end: 3.0, fov: 62.0, ease: InOut,
            from: Anchor(pos: (1.8, 2.6, -0.8), look: (0.0, 1.0, -9.0)),
            to:   Anchor(pos: (1.0, 2.3, -1.8), look: (0.0, 1.2, -10.0))),
        // Low and wide, drifting across the floor.
        (start: 3.0, end: 5.6, fov: 70.0, ease: Linear,
            from: Anchor(pos: (-1.6, 0.7, -2.4), look: (0.6, 1.3, -10.0)),
            to:   Anchor(pos: (-1.0, 0.8, -3.2), look: (0.4, 1.4, -11.0))),
        // Back to the door, into your eyes.
        (start: 5.6, end: 8.0, fov: 72.0, ease: InOut,
            from: Anchor(pos: (0.0, 1.8, -0.4), look: (0.0, 1.5, -10.0)),
            to:   PlayerEye),
    ],
    events: [
        (at: 0.0, do: Fade(alpha: 1.0, seconds: 0.0)),
        (at: 0.1, do: Fade(alpha: 0.0, seconds: 1.4)),
        (at: 0.3, do: Sfx(Rumble)),
        (at: 0.6, do: Title(text: "{floor}", sub: "CUSTOM FLOOR  -  {area}  -  {doors} DOORS", seconds: 3.6)),
        (at: 4.6, do: Subtitle(text: "[The door shuts behind you]", seconds: 2.0), players: Some((1, 1))),
        (at: 4.6, do: Subtitle(text: "[The door shuts behind {party}]", seconds: 2.0), players: Some((2, 5))),
        (at: 6.2, do: Sfx(Whoosh)),
        (at: 6.3, do: Subtitle(text: "Find the next door. Search the drawers. Listen to the lights.", seconds: 3.0)),
    ],
    end: GiveControl,
)
