// HALLWAYS cutscene: the descent. Plays when the lift leaves the boarding hall.
// Times are seconds; positions are (x, y, z) metres.
// The lift car spans x -1..1, z 5.2..8.2 (front gate at z 5.32, rear gate at z 8.08);
// Room 000 is x -4..4, z -5..5; the boarding hall is behind the car (z > 8.3).
// `players: Some((min, max))` limits a shot or event to that many players; in captions
// {n} is the number of players, {N} the number in words, {party} "you" / "the N of you".
// Music: drop music.ogg / music.mp3 / music.wav in this folder (see README.md).
(
    title: "Arrival",
    duration: 24.5,
    letterbox: true,
    skippable: true,
    shots: [
        // From the front of the car, looking back as the rear gate shuts.
        (start: 0.0, end: 3.0, fov: 64.0, ease: InOut,
            from: At(pos: (0.55, 1.75, 5.6), look: (0.0, 1.25, 8.1)),
            to:   At(pos: (0.45, 1.85, 5.75), look: (0.0, 1.35, 8.1))),
        // Solo: high in the back corner, alone with the closed gate and the dial.
        (start: 3.0, end: 6.0, fov: 60.0, ease: Linear, players: Some((1, 1)),
            from: At(pos: (0.75, 2.2, 8.0), look: (-0.15, 1.45, 5.2)),
            to:   At(pos: (0.6, 2.1, 7.8), look: (-0.05, 1.55, 5.2))),
        // A group: wide from the front corner over everyone crowded in the car.
        (start: 3.0, end: 6.0, fov: 70.0, ease: Linear, players: Some((2, 5)),
            from: At(pos: (0.85, 2.35, 5.45), look: (-0.25, 0.95, 7.4)),
            to:   At(pos: (0.75, 2.3, 5.55), look: (-0.1, 1.0, 7.6))),
        // Low, looking up at the ceiling lamp as the car shudders and sways.
        (start: 6.0, end: 9.0, fov: 58.0, ease: InOut,
            from: At(pos: (0.35, 0.7, 7.5), look: (0.0, 2.45, 6.6)),
            to:   At(pos: (0.25, 0.8, 7.2), look: (0.0, 2.45, 6.7))),
        // The dial: the needle ticks past the floors, one by one.
        (start: 9.0, end: 12.5, fov: 40.0, ease: Linear,
            from: At(pos: (0.3, 2.2, 6.5), look: (0.0, 2.37, 5.27)),
            to:   At(pos: (0.18, 2.28, 6.1), look: (0.0, 2.37, 5.27))),
        // Something on the roof: the view swings up to the ceiling in the dark.
        (start: 12.5, end: 15.5, fov: 66.0, ease: InOut,
            from: At(pos: (-0.3, 1.6, 7.6), look: (0.1, 1.7, 5.3)),
            to:   At(pos: (-0.2, 1.4, 7.0), look: (0.0, 2.6, 6.6))),
        // Close on the dial as the needle settles on the floor.
        (start: 15.5, end: 17.9, fov: 34.0, ease: InOut,
            from: At(pos: (0.25, 2.25, 6.25), look: (0.0, 2.37, 5.27)),
            to:   At(pos: (0.1, 2.33, 5.85), look: (0.0, 2.37, 5.27))),
        // Through the lattice as the gate rattles open.
        (start: 17.9, end: 20.3, fov: 60.0, ease: InOut,
            from: At(pos: (0.0, 1.5, 7.2), look: (0.0, 1.35, 0.0)),
            to:   At(pos: (0.0, 1.55, 6.2), look: (0.0, 1.35, 0.0))),
        // Wide from inside Room 000, looking back at the open lift.
        (start: 20.3, end: 22.5, fov: 55.0, ease: InOut,
            from: At(pos: (-2.8, 2.3, -1.0), look: (0.0, 1.3, 6.4)),
            to:   At(pos: (-2.3, 2.1, 0.2), look: (0.0, 1.3, 6.4))),
        (start: 22.5, end: 24.5, fov: 72.0, ease: InOut,
            from: At(pos: (0.0, 2.0, 7.0), look: (0.0, 1.5, 0.0)),
            to:   PlayerEye),
    ],
    events: [
        (at: 0.0, do: Fade(alpha: 1.0, seconds: 0.0)),
        (at: 0.1, do: Fade(alpha: 0.0, seconds: 1.2)),
        (at: 0.3, do: Subtitle(text: "[The gate shuts behind you]", seconds: 2.4), players: Some((1, 1))),
        (at: 0.3, do: Subtitle(text: "[The gate shuts behind {party}]", seconds: 2.4), players: Some((2, 5))),
        (at: 1.6, do: Sfx(Rumble)),
        (at: 1.9, do: Elevator(Needle(to: 1.0, seconds: 15.4))),
        (at: 3.1, do: Subtitle(text: "[The lift groans as it descends]", seconds: 2.4)),
        (at: 4.6, do: Subtitle(text: "[No one else is coming down]", seconds: 2.2), players: Some((1, 1))),
        (at: 4.6, do: Subtitle(text: "[{N} of you, and only one way down]", seconds: 2.2), players: Some((2, 5))),
        // The car shudders; the lamp flickers.
        (at: 6.2, do: Shake(0.35)),
        (at: 6.2, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.6)),
        (at: 6.6, do: Subtitle(text: "[The cables shriek. The car lurches and sways]", seconds: 2.4)),
        (at: 7.4, do: Shake(0.2)),
        (at: 8.4, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.0)),
        (at: 9.3, do: Subtitle(text: "[Floor after floor slides past in the dark]", seconds: 2.6)),
        (at: 11.0, do: Sfx(Ding)),
        // Blackout. Something lands on the roof... and is gone.
        (at: 12.6, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 0.04, flicker: 0.0)),
        (at: 12.7, do: Sfx(Rumble)),
        (at: 13.2, do: Shake(0.6)),
        (at: 13.3, do: Subtitle(text: "[Something heavy lands on the roof]", seconds: 2.0, danger: true)),
        (at: 14.4, do: Sfx(Whisper)),
        (at: 14.9, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.7)),
        (at: 15.2, do: Subtitle(text: "[...and then nothing]", seconds: 1.8)),
        (at: 16.3, do: Lights(color: (1.0, 1.0, 1.0), amount: 0.0, scale: 1.0, flicker: 0.0)),
        (at: 16.4, do: Subtitle(text: "[Floor 1]", seconds: 1.8)),
        (at: 17.5, do: Shake(0.2)),
        (at: 17.7, do: Sfx(Ding)),
        (at: 18.3, do: Elevator(OpenGate(seconds: 1.4))),
        (at: 18.5, do: Subtitle(text: "[The gate rattles open]", seconds: 2.0)),
        (at: 20.5, do: Title(text: "H A L L W A Y S", sub: "FLOOR 1  -  THE GUEST WING", seconds: 3.4), players: Some((1, 1))),
        (at: 20.5, do: Title(text: "H A L L W A Y S", sub: "FLOOR 1  -  THE GUEST WING  -  {N} PLAYERS", seconds: 3.4), players: Some((2, 5))),
        (at: 22.6, do: Sfx(Whoosh)),
        (at: 22.7, do: Subtitle(text: "Find the next door. Search the drawers. Listen to the lights.", seconds: 3.0), players: Some((1, 1))),
        (at: 22.7, do: Subtitle(text: "Stay together. Find the next door. Listen to the lights.", seconds: 3.0), players: Some((2, 5))),
    ],
    end: GiveControl,
)
