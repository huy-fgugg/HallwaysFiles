// HALLWAYS cutscene: retry. You come to in the lift; the gate opens on a new floor.
// The lift car spans x -1..1, z 5.2..8.2 (front gate at z 5.32).
(
    title: "Try Again",
    duration: 6.5,
    letterbox: true,
    skippable: true,
    shots: [
        // Waking in the back corner of the car.
        (start: 0.0, end: 2.6, fov: 62.0, ease: InOut,
            from: At(pos: (0.6, 0.9, 7.9), look: (0.0, 2.2, 5.2)),
            to:   At(pos: (0.55, 1.7, 7.7), look: (0.0, 1.5, 5.2))),
        // Through the lattice as the gate opens.
        (start: 2.6, end: 4.6, fov: 60.0, ease: InOut,
            from: At(pos: (0.0, 1.5, 7.0), look: (0.0, 1.35, 0.0)),
            to:   At(pos: (0.0, 1.55, 6.2), look: (0.0, 1.35, 0.0))),
        (start: 4.6, end: 6.5, fov: 72.0, ease: InOut,
            from: At(pos: (0.0, 1.8, 6.6), look: (0.0, 1.5, 0.0)),
            to:   PlayerEye),
    ],
    events: [
        (at: 0.0, do: Fade(alpha: 1.0, seconds: 0.0)),
        (at: 0.2, do: Fade(alpha: 0.0, seconds: 1.6)),
        (at: 0.4, do: Sfx(Heartbeat)),
        (at: 0.6, do: Subtitle(text: "[You come to in the lift. Again.]", seconds: 2.2), players: Some((1, 1))),
        (at: 0.6, do: Subtitle(text: "[{N} of you come to in the lift. Again.]", seconds: 2.2), players: Some((2, 5))),
        (at: 2.4, do: Sfx(Ding)),
        (at: 2.8, do: Elevator(OpenGate(seconds: 1.2))),
        (at: 3.0, do: Title(text: "TRY AGAIN", sub: "FLOOR 1  -  THE GUEST WING", seconds: 2.8)),
    ],
    end: GiveControl,
)
