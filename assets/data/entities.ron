// HALLWAYS entity tuning. Edit freely; if this file is broken the game uses its built-in copy.
//   min_room   first room the entity may appear in
//   chance     probability per eligible room (0..1)
//   cooldown   minimum rooms between two appearances of this entity
//   warn       seconds of warning cue before it acts (shrinks with depth, never below warn_min)
//   window     seconds you have to perform the counter (Whisperer / Hush)
//   damage     vitality lost on failure (100 = death). Surge/Undertow always kill.
(
    surge:     (min_room: 4,  chance: 0.32, cooldown: 4,  warn: 4.4, warn_min: 2.7, window: 0.0, damage: 100.0),
    undertow:  (min_room: 18, chance: 0.22, cooldown: 7,  warn: 4.0, warn_min: 2.8, window: 0.0, damage: 100.0),
    whisperer: (min_room: 6,  chance: 0.75, cooldown: 3,  warn: 2.2, warn_min: 1.3, window: 2.4, damage: 40.0),
    gallery:   (min_room: 10, chance: 0.25, cooldown: 5,  warn: 1.3, warn_min: 0.8, window: 0.0, damage: 15.0),
    hush:      (min_room: 9,  chance: 0.25, cooldown: 5,  warn: 1.2, warn_min: 0.8, window: 2.4, damage: 45.0),
    // Outdoors only. Blind: it hears footsteps. Crouch to move silently.
    listener:  (min_room: 21, chance: 0.65, cooldown: 2,  warn: 2.0, warn_min: 2.0, window: 0.0, damage: 100.0),
)
